# Vonkel Content Agent — environment variables
# Kopieer dit bestand naar `.env` en vul je credentials in.

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...
# Welk model de writer gebruikt. Sonnet 4.6 = goed + snel, Opus 4.6 = scherper maar duurder.
CLAUDE_MODEL=claude-sonnet-4-5

# --- Shopify Admin API ---
# Aanmaken via: Shopify admin > Apps > Develop apps > Create app > Admin API access token
SHOPIFY_STORE=vonkelwijnen.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxx
SHOPIFY_API_VERSION=2024-10
# ID van de blog waarin drafts geplaatst moeten worden (haal op via GET /admin/api/2024-10/blogs.json)
SHOPIFY_BLOG_ID=

# --- Agent gedrag ---
# Als "true": nooit publiceren, alleen lokaal wegschrijven.
AGENT_DEFAULT_DRY_RUN=true
# Minimale SEO-score voordat een artikel door audit komt (0-100)
AGENT_MIN_SEO_SCORE=85
